You are given an m x n grid. Each cell of grid represents a street. The street of grid[i][j] can be:

1.  which means a street connecting the left cell and the right cell.
2.  which means a street connecting the upper cell and the lower cell.
3.  which means a street connecting the left cell and the lower cell.
4.  which means a street connecting the right cell and the lower cell.
5.  which means a street connecting the left cell and the upper cell.
6.  which means a street connecting the right cell and the upper cell.



class Solution {
    public boolean hasValidPath(int[][] grid) {
      boolean[][] visited=new boolean[grid.length][grid[0].length];
        return dfs(grid,visited,0,0);
    }
    public static boolean dfs(int[][]grid,boolean[][] visited,int i,int j){
        //boundary check
        if(i>=grid.length || i<=-1 || j>=grid[0].length || j<=-1)return false;
        if(visited[i][j])return false;
        visited[i][j]=true;
        //destination check
        if(i==grid.length-1 && j==grid[0].length-1)return true;
       int street=grid[i][j];

        //down
        if((street==2 || street==3 || street==4)   && i+1<grid.length && (grid[i+1][j]==2 || grid[i+1][j]==5 || grid[i+1][j]==6)){
            if(dfs(grid,visited,i+1,j))return true;
        }
        //up
       if((street==2 || street==5 || street==6)   && i-1>=0 && (grid[i-1][j]==2 || grid[i-1][j]==3 || grid[i-1][j]==4)){
            if(dfs(grid,visited,i-1,j))return true;
        }
        //left
         if((street==1 || street==3 || street==5)   && j-1>=0 && (grid[i][j-1]==1 || grid[i][j-1]==4 || grid[i][j-1]==6)){
            if(dfs(grid,visited,i,j-1))return true;
        }
        //right
         if((street==1 || street==4 || street==6 )  && j+1<grid[0].length &&( grid[i][j+1]==1 || grid[i][j+1]==3 || grid[i][j+1]==5)){
            if(dfs(grid,visited,i,j+1))return true;
        }


       return false;
    }
}

