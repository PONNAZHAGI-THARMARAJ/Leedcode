class Solution {
    public int findLengthOfLCIS(int[] nums) {
        int maxi=0;
        int j=0;
        if(nums.length==1)return 1;
        while(j<nums.length-1){
            int count=1;
        for(int i=j+1;i<nums.length;i++){
            if(nums[i-1]<nums[i]){
                 count++;
            }else{
                break;
            }
        }
        maxi=Math.max(count,maxi);
        j++;
        }
        return maxi;
    }
}
